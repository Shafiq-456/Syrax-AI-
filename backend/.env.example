# --- Copy this file to .env and fill in real values ---

# App
APP_NAME=Syrax
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./syrax.db

# Part 2: GitHub search
GITHUB_TOKEN=

# Part 3/5/7/8: LLM calls (idea analysis, similarity judging, recommendations, architecture)
ANTHROPIC_API_KEY=

# Part 4: RAG — local embedding model, no key needed (sentence-transformers)
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Semantic Scholar needs no API key for basic use.
